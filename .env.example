# Public canonical URL. Replace with the real HTTPS domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only Telegram credentials. Never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Enable public indexing only after content and legal details are confirmed.
SITE_INDEXABLE=false
# Optional durable rate limiting (Upstash Redis REST). Recommended on serverless/multi-instance deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
